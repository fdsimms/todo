{
  "expo": {
    "name": "dundundun",
    "slug": "dundundun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dundundun",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fdsimms.dundundun",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAlarmKitUsageDescription": "Used to ring reminders as system alarms that break through silent mode.",
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A84FF"
      },
      "package": "com.fdsimms.dundundun",
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "iosDisplayInForeground": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "remindersPermission": "Lets dundundun move tasks out of the Reminders app and into your Inbox, so anything you dictate to Siri ends up here.",
          "calendarPermission": "Lets dundundun see what's already on a day — the calendars you pick, including a Google account added on this device — so it can tell how much of the day is free. It only adds events to a calendar you pick yourself in Settings, for deadlines and planned meals you turn on; it changes nothing else."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Lets dundundun ask for Face ID before it opens, so an unlocked phone doesn't hand over your task list."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Lets dundundun ask for Face ID before it opens, so an unlocked phone doesn't hand over your task list."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets dundundun read a recipe out of a photo you've already taken, so a cookbook page you snapped becomes a recipe instead of something to retype.",
          "cameraPermission": "Lets dundundun read a recipe straight off the page you point the camera at — a cookbook, a recipe card, a clipping.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      "./plugins/withAppGroup",
      "./plugins/withWidgetExtension",
      "./plugins/withAlarmKit",
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "add",
              "title": "Add Task",
              "icon": "symbol:square.and.pencil"
            },
            {
              "id": "groceries",
              "title": "Groceries",
              "icon": "symbol:cart"
            },
            {
              "id": "search",
              "title": "Search",
              "icon": "symbol:magnifyingglass"
            },
            {
              "id": "projects",
              "title": "Projects",
              "icon": "symbol:briefcase"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dc3d4782-26cd-4447-8b51-06af03290e9c",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "TodoWidget",
                  "bundleIdentifier": "com.fdsimms.dundundun.TodoWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.fdsimms.dundundun"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
