{
  "expo": {
    "name": "dundundun",
    "slug": "dundundun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dundundun",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fdsimms.dundundun",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAlarmKitUsageDescription": "Used to ring reminders as system alarms that break through silent mode."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A84FF"
      },
      "package": "com.fdsimms.dundundun",
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "iosDisplayInForeground": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "remindersPermission": "Lets dundundun move tasks out of the Reminders app and into your Inbox, so anything you dictate to Siri ends up here.",
          "calendarPermission": false
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      "./plugins/withAppGroup",
      "./plugins/withWidgetExtension",
      "./plugins/withAlarmKit"
    ],
    "extra": {
      "eas": {
        "projectId": "dc3d4782-26cd-4447-8b51-06af03290e9c",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "TodoWidget",
                  "bundleIdentifier": "com.fdsimms.dundundun.TodoWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.fdsimms.dundundun"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
