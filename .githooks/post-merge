#!/bin/sh
# .gitattributes merges the generated docs with `union`, which never conflicts
# but can leave a duplicated line where both sides rewrote the same fact — and
# in any case the source tree the docs are generated *from* only reflects both
# sides once the merge is done. So rerun the generators here, and let them say
# what the docs should say.
#
# It leaves the result in the working tree rather than amending the merge
# commit — a hook that rewrites a commit you did not ask it to rewrite is worse
# than a dirty `git status`, and dirty is exactly the signal that was missing.
node scripts/build-module-map.js >/dev/null 2>&1
node scripts/check-doc-stats.js >/dev/null 2>&1
node scripts/build-screen-map.js >/dev/null 2>&1

if ! git diff --quiet -- docs/module-map.md docs/screen-map.md docs/repo-stats.md 2>/dev/null; then
  echo
  echo "post-merge: the merge changed what the generated docs should say."
  echo "  docs/module-map.md, docs/screen-map.md and/or docs/repo-stats.md"
  echo "  have been regenerated in your working tree. Commit them with the merge:"
  echo
  echo "    git add docs/module-map.md docs/screen-map.md docs/repo-stats.md && git commit --amend --no-edit"
  echo
fi
