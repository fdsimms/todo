{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "watch-canary": {
      "extends": "production",
      "env": {
        "DUNDUNDUN_WATCH_APP": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6795983882"
      }
    }
  }
}
