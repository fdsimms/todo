{
  "name": "dundundun",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build:patchnotes": "node scripts/build-patch-notes.js",
    "postinstall": "patch-package && npm run build:patchnotes",
    "prestart": "npm run build:patchnotes",
    "preandroid": "npm run build:patchnotes",
    "preios": "npm run build:patchnotes",
    "pretest": "npm run build:patchnotes",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "globals": {
      "__DEV__": true
    },
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(expo-sqlite|expo-haptics|expo-notifications|expo-calendar|expo-secure-store|expo-local-authentication|expo-status-bar|expo|@expo|date-fns)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/**/*.test.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "functions": 25,
        "lines": 15,
        "statements": 15,
        "branches": 15
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "date-fns": "^4.4.0",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.7",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.7",
    "expo-calendar": "~15.0.8",
    "expo-document-picker": "~14.0.6",
    "expo-file-system": "~19.0.11",
    "expo-font": "~14.0.7",
    "expo-haptics": "~15.0.6",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.10",
    "expo-quick-actions": "~6.0.2",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.6",
    "expo-sharing": "~14.0.7",
    "expo-sqlite": "~16.0.8",
    "expo-status-bar": "~3.0.7",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "todo-alarmkit-bridge": "file:./modules/todo-alarmkit-bridge",
    "todo-widget-bridge": "file:./modules/todo-widget-bridge",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "babel-jest": "^30.4.1",
    "babel-preset-expo": "~54.0.12",
    "better-sqlite3": "^13.0.3",
    "jest": "~30.4.2",
    "jest-environment-node": "~30.4.1",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
